<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (Dark Mode) -->
    <style name="Base.Theme.ReceiptFlow" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/gruvbox_dark_green</item>
        <item name="colorOnPrimary">@color/gruvbox_dark_bg</item>
        <item name="colorSecondary">@color/gruvbox_dark_blue</item>
        <item name="colorOnSecondary">@color/gruvbox_dark_bg</item>
        <item name="colorTertiary">@color/gruvbox_dark_aqua</item>
        <item name="colorOnTertiary">@color/gruvbox_dark_bg</item>

        <item name="android:windowBackground">@color/gruvbox_dark_bg</item>
        <item name="colorSurface">@color/gruvbox_dark_bg_soft</item>
        <item name="colorOnSurface">@color/gruvbox_dark_fg</item>
        <item name="colorSurfaceVariant">@color/gruvbox_dark_bg_soft</item>
        <item name="colorOnSurfaceVariant">@color/gruvbox_dark_fg</item>
        <item name="colorSurfaceContainer">@color/gruvbox_dark_bg_soft</item>

        <item name="colorError">@color/gruvbox_dark_red</item>
        <item name="colorOnError">@color/gruvbox_dark_bg</item>
        <item name="colorOutline">@color/gruvbox_dark_gray</item>
